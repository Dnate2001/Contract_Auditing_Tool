# Environment Configuration for Contract Auditing Tool

# =============================================================================
# CORE CONFIGURATION
# =============================================================================

# Google Gemini API Key (optional - falls back to simulation mode)
GEMINI_API_KEY=

# Operation Mode
MODE=simulation  # Options: simulation, production

# Medusa Fuzzer Configuration
MEDUSA_TIMEOUT=60
MEDUSA_WORKERS=4

# Logging
LOG_LEVEL=INFO

# =============================================================================
# DEMO MODE (OPTIONAL - DISABLED BY DEFAULT)
# =============================================================================
# WARNING: Demo mode exposes a public HTTP endpoint via ngrok
# Only enable for temporary demos with trusted reviewers

# Enable demo server (default: false)
DEMO_MODE=false

# Demo HTTP Basic Auth Credentials
# IMPORTANT: Change these to strong values before enabling demo mode
DEMO_USER=demo_user
DEMO_PASS=change_me_strong_password

# Optional CIDR IP Allow-list (comma-separated)
# Example: "203.0.113.0/24,198.51.100.0/24"
# Leave empty to allow all IPs (not recommended for production demos)
DEMO_CIDR_ALLOW=

# Demo server auto-shutdown timer (seconds)
# Default: 10800 (3 hours)
DEMO_TTL_SECONDS=10800

# ngrok Authentication Token
# Get your token from: https://dashboard.ngrok.com/get-started/your-authtoken
# Required for demo mode
NGROK_AUTHTOKEN=

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Data directory for artifacts
DATA_DIR=/data

# Server port (for demo mode)
PORT=8080

# Resource limits
MAX_MEMORY=2g
API_RATE_LIMIT=10

# Feature flags
ENABLE_SARIF=true
ENABLE_REPRODUCERS=true
ENABLE_AI=true
